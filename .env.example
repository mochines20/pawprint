# Copy this file to .env.local and replace the placeholders locally.
# Use a publishable/anon key only. Never put a service_role or secret key here.
PAWPRINT_SUPABASE_URL=https://your-project.supabase.co
PAWPRINT_SUPABASE_ANON_KEY=your-fresh-publishable-or-anon-key
# Set true only after the matching provider is enabled in Supabase with OAuth credentials.
PAWPRINT_GOOGLE_AUTH_ENABLED=false
PAWPRINT_APPLE_AUTH_ENABLED=false
# Server-only image validation. Keep this out of browser code and never expose it as a public key.
GEMINI_API_KEY=replace-with-server-secret
GEMINI_MODEL=gemini-2.5-flash
AI_CAT_CONFIDENCE_THRESHOLD=0.78
AI_GENERATED_CONFIDENCE_THRESHOLD=0.80
# Optional provider-neutral validator fallback.
AI_VALIDATION_URL=
AI_VALIDATION_TOKEN=
