# Copy this file to .env.local and replace the placeholders locally.
# Use a publishable/anon key only. Never put a service_role or secret key here.
PAWPRINT_SUPABASE_URL=https://your-project.supabase.co
PAWPRINT_SUPABASE_ANON_KEY=your-fresh-publishable-or-anon-key
# Set true only after the matching provider is enabled in Supabase with OAuth credentials.
PAWPRINT_GOOGLE_AUTH_ENABLED=false
PAWPRINT_APPLE_AUTH_ENABLED=false
# Optional Supabase Edge Function URL. If empty, it is derived from
# PAWPRINT_SUPABASE_URL as /functions/v1/pawprint-api.
PAWPRINT_SUPABASE_FUNCTION_URL=
# Server-only image validation. Keep this out of browser code and never expose it as a public key.
GEMINI_API_KEY=replace-with-server-secret
GEMINI_MODEL=gemini-2.5-flash
AI_CAT_CONFIDENCE_THRESHOLD=0.78
AI_GENERATED_CONFIDENCE_THRESHOLD=0.80
# Optional Ollama/Qwen provider (server-side only).
AI_PROVIDER=gemini
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_API_MODE=native
OLLAMA_API_TOKEN=
# Optional provider-neutral validator fallback.
AI_VALIDATION_URL=
AI_VALIDATION_TOKEN=
# Brevo transactional email for waitlist confirmations and launch updates.
BREVO_API_KEY=replace-with-server-secret
BREVO_SENDER_EMAIL=hello@example.com
BREVO_SENDER_NAME=Pawprint
BREVO_TEMPLATE_ID=
# Web Push subscription registration. Keep the private key in Supabase
# Edge Function secrets, never in the browser bundle.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=replace-with-server-secret
PUSH_SUBJECT=mailto:hello@example.com
ADMIN_USER_IDS=
EXPIRY_JOB_TOKEN=replace-with-server-secret
MAINTENANCE_TOKEN=replace-with-server-secret
