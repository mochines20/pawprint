name = "pawprint"
main = "dist/server/index.js"
compatibility_date = "2026-10-17"
workers_dev = true

# Copy this file to wrangler.toml and replace the placeholders before deploying.
# The D1 and R2 bindings are the durable source for sightings, Journal, rewards,
# and private photos. Supabase remains the Auth/profile provider.

[[d1_databases]]
binding = "DB"
database_name = "pawprint"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "drizzle"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "pawprint-photos"

[triggers]
crons = ["*/5 * * * *", "17 3 * * *"]

[vars]
SUPABASE_GOOGLE_AUTH_ENABLED = "false"
SUPABASE_APPLE_AUTH_ENABLED = "false"
AI_PROVIDER = "gemini"
GEMINI_MODEL = "gemini-2.5-flash"
AI_CAT_CONFIDENCE_THRESHOLD = "0.78"
AI_GENERATED_CONFIDENCE_THRESHOLD = "0.85"

# Add runtime secrets with:
# wrangler secret put SUPABASE_URL
# wrangler secret put SUPABASE_ANON_KEY
# wrangler secret put GEMINI_API_KEY (or configure Ollama/Qwen secrets)
# wrangler secret put BREVO_API_KEY
# wrangler secret put BREVO_SENDER_EMAIL
# wrangler secret put ADMIN_USER_IDS
# wrangler secret put EXPIRY_JOB_TOKEN
# wrangler secret put PUSH_PRIVATE_KEY
# wrangler secret put PUSH_SUBJECT
